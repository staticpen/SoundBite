@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SoundBite — Discover music</PageTitle>

<section id="home-hero" class="p-4 p-md-5 mb-4 bg-body-tertiary rounded-3" aria-labelledby="home-hero-title">
    <div class="container-fluid py-2">
        @if (signedIn)
        {
            <h1 id="home-hero-title" class="display-5 fw-bold">@welcomeMessage</h1>
            <p class="col-md-8 fs-5">
                Find artists, albums, and tracks in the SoundBite catalogue, then read and share reviews with the community.
            </p>
            <a class="btn btn-primary btn-lg" href="/search">Search the catalogue</a>
        }
        else
        {
            <h1 id="home-hero-title" class="display-5 fw-bold">Discover music with SoundBite</h1>
            <p class="col-md-8 fs-5">
                Log in to join the SoundBite community and make the catalogue your own.
            </p>
            <ul class="col-md-8 fs-5 mb-4">
                <li>Rate tracks</li>
                <li>Write reviews</li>
                <li>Follow other listeners</li>
                <li>Create playlists</li>
            </ul>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="/login">Log in</a>
                <a class="btn btn-outline-secondary btn-lg" href="/register">Create account</a>
            </div>
        }
    </div>
</section>

<div class="row g-3">
    <section class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4">Browse music</h2>
                <p>Explore artists, albums, and tracks currently available in the catalogue.</p>
                <a href="/search">Search artists, albums, and tracks</a>
            </div>
        </div>
    </section>
    <section class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4">Discover playlists</h2>
                <p>Browse public playlists and find a new collection of tracks.</p>
                <a href="/playlists">Explore playlists</a>
            </div>
        </div>
    </section>
    <section class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4">Join the community</h2>
                <p>Follow listeners, rate tracks, and share your perspective.</p>
                <a href="/feed">View the activity feed</a>
            </div>
        </div>
    </section>
    <section class="col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4">Ratings and trends</h2>
                <p>See the community's highest-rated, most-reviewed, and currently trending tracks.</p>
                <a href="/rankings">Explore track rankings</a>
            </div>
        </div>
    </section>
</div>

@code {
    private bool signedIn;
    private string welcomeMessage = "Welcome back to SoundBite. Discover music and share what you love.";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        signedIn = user.Identity?.IsAuthenticated == true;
        if (signedIn && !string.IsNullOrWhiteSpace(user.Identity?.Name))
            welcomeMessage = $"Welcome, {user.Identity.Name}. Discover music and share what you love.";
    }
}
