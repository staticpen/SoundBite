@page "/notifications"
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SoundBite.Models
@using SoundBite.Services
@inject NotificationService NotificationService
@inject NotificationEventDispatcher NotificationEventDispatcher
@inject NotificationCircuitHandler NotificationCircuitHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Notifications> Logger

<PageTitle>Notifications - SoundBite</PageTitle>

<h1>Notifications</h1>

@if (loading)
{
    <p role="status">Loading notifications...</p>
}
else if (!signedIn)
{
    <p><a href="/login">Log in</a> to view your notifications.</p>
}
else if (loadFailed && !loaded)
{
    <div class="alert alert-danger" role="alert">
        Notifications couldn't be loaded.
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Try again</button>
    </div>
}
else if (loaded)
{
    @if (loadFailed)
    {
        <div class="alert alert-danger" role="alert">
            Notifications couldn't be refreshed. The list below may be out of date.
            <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Try again</button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="mb-0">@unreadCount unread</p>
        @if (unreadCount > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="MarkAllReadAsync" disabled="@busy">
                Mark all as read
            </button>
        }
    </div>

    @if (items.Count == 0)
    {
        <p class="text-muted">You don't have any notifications yet.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var item in items)
            {
                <li class="list-group-item @(item.ReadAt is null ? "list-group-item-primary" : string.Empty)" @key="item.Id">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <p class="mb-1">
                                @if (item.Type == NotificationType.Follow)
                                {
                                    <a href="@($"/users/{Uri.EscapeDataString(item.ActorUserName)}")">@item.ActorName</a>
                                    <span> followed you.</span>
                                }
                                else if (item.Type == NotificationType.PlaylistLike)
                                {
                                    <a href="@($"/users/{Uri.EscapeDataString(item.ActorUserName)}")">@item.ActorName</a>
                                    <span> liked your playlist </span>
                                    <a href="@($"/playlists/{item.PlaylistId}")">@item.PlaylistName</a>
                                    <span>.</span>
                                }
                                else
                                {
                                    <a href="@($"/users/{Uri.EscapeDataString(item.ActorUserName)}")">@item.ActorName</a>
                                    <span>
                                        @(item.Type switch
                                        {
                                            NotificationType.ReviewComment => " commented on your review.",
                                            NotificationType.CommentReply => " replied to your comment.",
                                            NotificationType.ReviewLike => " liked your review.",
                                            NotificationType.CommentLike => " liked your comment.",
                                            _ => " interacted with your activity."
                                        })
                                    </span>
                                    @if (item.TrackId is int trackId && item.ReviewId is int reviewId)
                                    {
                                        <a href="@($"/tracks/{trackId}#review-{reviewId}")">View review</a>
                                    }
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Content))
                            {
                                <p class="mb-1 text-muted">@item.Content</p>
                            }
                            <time class="text-muted small" datetime="@item.CreatedAt.ToString("O")">
                                @item.CreatedAt.ToLocalTime().ToString("g")
                            </time>
                        </div>
                        @if (item.ReadAt is null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap"
                                    @onclick="() => MarkReadAsync(item.Id)" disabled="@busy">
                                Mark read
                            </button>
                        }
                    </div>
                </li>
            }
        </ul>

        @if (hasMore)
        {
            <button type="button" class="btn btn-outline-primary mt-3" @onclick="LoadMoreAsync" disabled="@(loadingMore || refreshing || busy)">
                @(loadingMore ? "Loading..." : "Load more")
            </button>
            @if (loadMoreFailed)
            {
                <p class="alert alert-danger mt-2" role="alert">Older notifications couldn't be loaded. Please try again.</p>
            }
        }
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="mt-3" role="status">@message</p>
    }
}

@code {
    private readonly List<NotificationItem> items = [];
    private int unreadCount;
    private bool hasMore;
    private bool loaded;
    private bool loadingMore;
    private bool loadMoreFailed;
    private bool refreshing;
    private int loadGeneration; // bumped by every refresh so older requests can be ignored
    private bool loading = true;
    private bool loadFailed;
    private bool signedIn;
    private bool busy;
    private string? message;
    private readonly List<IDisposable> subscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        signedIn = user.Identity?.IsAuthenticated == true &&
            !string.IsNullOrWhiteSpace(user.FindFirstValue(ClaimTypes.NameIdentifier));
        if (signedIn)
        {
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;
            subscriptions.Add(NotificationEventDispatcher.Subscribe(userId, RefreshNotificationPageAsync));
            subscriptions.Add(NotificationCircuitHandler.Subscribe(RefreshNotificationPageAsync));
            await LoadAsync();
        }
        loading = false;
    }

    private Task RefreshNotificationPageAsync() => InvokeAsync(LoadAndRenderAsync);

    private async Task LoadAndRenderAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    // Replaces the list with the newest page. Anything loaded with "Load more" is dropped,
    // so read states and deleted notifications always match the database.
    // If the refresh fails, the list that was already shown is kept and an error with a retry is displayed.
    private async Task LoadAsync()
    {
        var generation = ++loadGeneration;
        refreshing = true;
        loadFailed = false;
        // Any "Load more" still running is now out of date (its result will be ignored),
        // so clear its state here rather than relying on this refresh succeeding.
        loadingMore = false;
        loadMoreFailed = false;
        StateHasChanged(); // show that a refresh is running (Load more is disabled)
        try
        {
            var result = await NotificationService.GetPageAsync();
            if (generation != loadGeneration) return; // a newer refresh has started

            items.Clear();
            items.AddRange(result.Items);
            unreadCount = result.UnreadCount;
            hasMore = result.HasMore;
            loaded = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load notifications");
            if (generation == loadGeneration)
                loadFailed = true;
        }
        finally
        {
            if (generation == loadGeneration)
                refreshing = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (loadingMore || refreshing || !hasMore || items.Count == 0) return;
        var generation = loadGeneration;
        loadingMore = true;
        loadMoreFailed = false;
        try
        {
            var last = items[^1];
            var result = await NotificationService.GetPageAsync(last.CreatedAt, last.Id);
            if (generation != loadGeneration) return; // a refresh replaced the list while this was loading

            var shownIds = items.Select(item => item.Id).ToHashSet();
            items.AddRange(result.Items.Where(item => !shownIds.Contains(item.Id)));
            unreadCount = result.UnreadCount;
            hasMore = result.HasMore;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load older notifications");
            if (generation == loadGeneration)
                loadMoreFailed = true;
        }
        finally
        {
            if (generation == loadGeneration)
                loadingMore = false;
        }
    }

    private async Task MarkReadAsync(int notificationId)
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            await NotificationService.MarkReadAsync(notificationId);
            await LoadAsync();
            message = loadFailed ? null : "Notification marked as read.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to mark notification {NotificationId} as read", notificationId);
            message = "The notification couldn't be marked as read. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task MarkAllReadAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        try
        {
            await NotificationService.MarkAllReadAsync();
            await LoadAsync();
            message = loadFailed ? null : "All notifications marked as read.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to mark all notifications as read");
            message = "Notifications couldn't be marked as read. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        foreach (var subscription in subscriptions)
            subscription.Dispose();
    }
}
