@page "/tracks/{Id:int}"
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SoundBite.Interfaces
@using SoundBite.Models
@using SoundBite.Services
@inject IMusicCatalog Catalog
@inject ReviewService Reviews
@inject DemoReviewService DemoReviews
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<TrackDetails> Logger

<PageTitle>@(track?.Title ?? "Track details") - SoundBite</PageTitle>

<h1>Track details</h1>

@if (loading)
{
    <p role="status">Loading track...</p>
}
else if (Id <= 0)
{
    <div class="alert alert-warning" role="alert">Invalid track ID. Please use a positive whole number.</div>
}
else if (failed)
{
    <div class="alert alert-danger" role="alert">We couldn't load this track. Please try again later.</div>
}
else if (track is null)
{
    <div class="alert alert-info" role="status">Track not found.</div>
}
else
{
    <article class="card">
        <div class="card-body">
            <h2 class="card-title">@track.Title</h2>
            <h3 class="h5">Artists</h3>
            @if (track.Artists.Count == 0)
            {
                <p class="text-muted">No artist information available.</p>
            }
            else
            {
                <ul>
                    @foreach (var artist in track.Artists)
                    {
                        <li>@artist.Name</li>
                    }
                </ul>
            }
            <h3 class="h5">Album</h3>
            @if (track.Album is { } album)
            {
                <p>@album.Title</p>
                @if (!string.IsNullOrWhiteSpace(album.SpotifyId))
                {
                    <p>Album Spotify ID: <code>@album.SpotifyId</code>
                        <a href="@SpotifyUrl("album", album.SpotifyId)" class="ms-2">Open album on Spotify</a>
                    </p>
                }
            }
            else
            {
                <p class="text-muted">No album information available.</p>
            }
            @if (!string.IsNullOrWhiteSpace(track.SpotifyId))
            {
                <h3 class="h5">Spotify</h3>
                <p>Track Spotify ID: <code>@track.SpotifyId</code></p>
                <a href="@SpotifyUrl("track", track.SpotifyId)" class="btn btn-outline-success">Open track on Spotify</a>
            }
        </div>
    </article>
    <div class="mt-3" aria-label="Track likes">
        <LikeButton TargetType="LikeTargetType.Track" TargetId="@track.Id" />
    </div>

    <section class="mt-4" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading">Reviews (@reviews.Count)</h2>

        @if (reviewLoadFailed)
        {
            <div class="alert alert-danger" role="alert">Reviews couldn't be loaded. Please try again later.</div>
        }
        else if (string.IsNullOrWhiteSpace(currentUserId))
        {
            <p><a href="/login">Log in</a> to rate and review this track.</p>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="h5">@(currentUserReview is null ? "Write a review" : "Edit your review")</h3>
                    <EditForm Model="reviewInput" OnValidSubmit="SaveReviewAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="review-rating">Rating</label>
                            <InputSelect id="review-rating" @bind-Value="reviewInput.Rating" class="form-select">
                                <option value="0">Choose a rating</option>
                                @for (var rating = 1; rating <= 5; rating++)
                                {
                                    <option value="@rating">@rating / 5 stars</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => reviewInput.Rating)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="review-comment">Written review (optional)</label>
                            <InputTextArea id="review-comment" @bind-Value="reviewInput.Comment" class="form-control" maxlength="2000" rows="4" />
                            <ValidationMessage For="@(() => reviewInput.Comment)" />
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@savingReview">
                            @(savingReview ? "Saving..." : currentUserReview is null ? "Submit review" : "Update review")
                        </button>
                        @if (!string.IsNullOrWhiteSpace(reviewMessage))
                        {
                            <p class="mt-3 mb-0" role="status">@reviewMessage</p>
                        }
                    </EditForm>
                </div>
            </div>
        }

        @if (reviews.Count == 0 && !reviewLoadFailed)
        {
            <p class="text-muted">No reviews yet. Be the first to rate this track.</p>
        }
        else if (reviews.Count > 0)
        {
            <div class="list-group">
                @foreach (var review in reviews)
                {
                    var reviewerName = string.IsNullOrWhiteSpace(review.User?.DisplayName)
                        ? review.User?.UserName ?? "SoundBite user"
                        : review.User.DisplayName;
                    <article id="@($"review-{review.Id}")" class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <h3 class="h6 mb-1">
                                @if (!string.IsNullOrWhiteSpace(review.User?.UserName))
                                {
                                    <a href="@($"/users/{Uri.EscapeDataString(review.User.UserName)}")">@reviewerName</a>
                                }
                                else
                                {
                                    @reviewerName
                                }
                            </h3>
                            <span class="badge text-bg-warning">@review.Rating / 5 stars</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mb-0 mt-2">@review.Comment</p>
                        }
                        <ReviewSocialPanel @key="review.Id" ReviewId="@review.Id" />
                    </article>
                }
            </div>
        }

        @if (demoReviews.Count > 0)
        {
            <section class="mt-4" aria-labelledby="demo-reviews-heading">
                <h3 id="demo-reviews-heading">Sample reviews (demo data)</h3>
                <p class="text-muted">These examples are for demonstration and are not real user submissions.</p>
                <div class="list-group">
                    @foreach (var review in demoReviews)
                    {
                        <article class="list-group-item" @key="review.Id">
                            <div class="d-flex justify-content-between align-items-start">
                                <h4 class="h6 mb-1">@review.ReviewerLabel <span class="badge text-bg-info">Sample</span></h4>
                                <span class="badge text-bg-warning">@review.Rating / 5 stars</span>
                            </div>
                            <p class="mb-0 mt-2">@review.Comment</p>
                        </article>
                    }
                </div>
            </section>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Track? track;
    private bool loading;
    private bool failed;
    private int loadVersion;
    private IReadOnlyList<Review> reviews = [];
    private IReadOnlyList<DemoReview> demoReviews = [];
    private Review? currentUserReview;
    private string? currentUserId;
    private bool reviewLoadFailed;
    private bool savingReview;
    private string? reviewMessage;
    private readonly ReviewInput reviewInput = new();

    protected override async Task OnParametersSetAsync()
    {
        var version = ++loadVersion;
        track = null;
        failed = false;
        reviews = [];
        demoReviews = [];
        currentUserReview = null;
        currentUserId = null;
        reviewLoadFailed = false;
        reviewMessage = null;
        reviewInput.Rating = 0;
        reviewInput.Comment = string.Empty;
        loading = Id > 0;
        if (!loading) return;

        var requestedId = Id;
        try
        {
            var result = await Catalog.GetTrackAsync(requestedId);
            if (version != loadVersion) return;
            track = result;
            if (track is null) return;

            try
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
                var trackReviews = await Reviews.GetReviewsForTrackAsync(requestedId);
                var trackDemoReviews = await DemoReviews.GetForTrackAsync(requestedId);
                var userReview = string.IsNullOrWhiteSpace(userId)
                    ? null
                    : await Reviews.GetUserReviewForTrackAsync(userId, requestedId);

                if (version != loadVersion) return;
                currentUserId = userId;
                reviews = trackReviews;
                demoReviews = trackDemoReviews;
                currentUserReview = userReview;
                if (userReview is not null)
                {
                    reviewInput.Rating = userReview.Rating;
                    reviewInput.Comment = userReview.Comment;
                }
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Unable to load reviews for track {TrackId}", requestedId);
                if (version == loadVersion) reviewLoadFailed = true;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load track {TrackId}", requestedId);
            if (version == loadVersion) failed = true;
        }
        finally
        {
            if (version == loadVersion) loading = false;
        }
    }

    private async Task SaveReviewAsync()
    {
        if (string.IsNullOrWhiteSpace(currentUserId) || track is null)
            return;

        savingReview = true;
        reviewMessage = null;
        try
        {
            if (currentUserReview is null)
            {
                currentUserReview = await Reviews.CreateReviewAsync(
                    currentUserId, track.Id, reviewInput.Rating, reviewInput.Comment);
                reviewMessage = "Your review was submitted.";
            }
            else
            {
                currentUserReview = await Reviews.UpdateReviewAsync(
                    currentUserReview.Id, currentUserId, reviewInput.Rating, reviewInput.Comment);
                reviewMessage = "Your review was updated.";
            }

            reviews = await Reviews.GetReviewsForTrackAsync(track.Id);
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogInformation(exception, "Review operation was rejected for track {TrackId}", track.Id);
            reviewMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save review for track {TrackId}", track.Id);
            reviewMessage = "Your review couldn't be saved. Please try again.";
        }
        finally
        {
            savingReview = false;
        }
    }

    private static string SpotifyUrl(string type, string id) =>
        $"https://open.spotify.com/{type}/{Uri.EscapeDataString(id)}";

    private sealed class ReviewInput
    {
        [Range(1, 5, ErrorMessage = "Choose a rating from 1 to 5.")]
        public int Rating { get; set; }

        [MaxLength(2000)]
        public string Comment { get; set; } = string.Empty;
    }
}
