@page "/playlists"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SoundBite.Models
@using SoundBite.Services
@inject PlaylistService PlaylistManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<Playlists> Logger

<PageTitle>Playlists - SoundBite</PageTitle>

<div class="content-column">
    <h1>Playlists</h1>
    <p>Discover public playlists from the SoundBite community.</p>

    @if (!string.IsNullOrWhiteSpace(userId))
    {
        <section class="card mb-4" aria-labelledby="create-playlist-heading">
            <div class="card-body">
                <h2 id="create-playlist-heading" class="h4">Create a playlist</h2>
                <EditForm Model="createModel" OnValidSubmit="CreatePlaylistAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label" for="playlist-name">Name</label>
                        <InputText id="playlist-name" @bind-Value="createModel.Name" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="playlist-description">Description (optional)</label>
                        <InputTextArea id="playlist-description" @bind-Value="createModel.Description" class="form-control" maxlength="1000" rows="3" />
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@busy">Create playlist</button>
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <p class="mt-3 mb-0" role="status">@message</p>
                    }
                </EditForm>
            </div>
        </section>
    }
    else
    {
        <p><a href="/login">Log in</a> to create your own playlists.</p>
    }

    @if (loading)
    {
        <p role="status">Loading playlists...</p>
    }
    else if (loadFailed)
    {
        <div class="alert alert-danger" role="alert">Playlists couldn't be loaded. Please try again later.</div>
    }
    else if (playlists.Count == 0)
    {
        <p class="text-muted">No public playlists yet.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var playlist in playlists)
            {
                var ownerName = string.IsNullOrWhiteSpace(playlist.Owner?.DisplayName)
                    ? playlist.Owner?.UserName ?? "SoundBite user"
                    : playlist.Owner.DisplayName;
                <div class="col-md-6 col-lg-4" @key="playlist.Id">
                    <article class="card h-100">
                        <div class="card-body">
                            <h2 class="h5"><a href="@($"/playlists/{playlist.Id}")">@playlist.Name</a></h2>
                            <p class="text-muted">By @ownerName · @playlist.Items.Count tracks</p>
                            @if (!string.IsNullOrWhiteSpace(playlist.Description))
                            {
                                <p class="card-text">@playlist.Description</p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly CreatePlaylistInput createModel = new();
    private IReadOnlyList<Playlist> playlists = [];
    private string? userId;
    private string? message;
    private bool loading = true;
    private bool loadFailed;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadPlaylistsAsync();
    }

    private async Task LoadPlaylistsAsync()
    {
        loading = true;
        loadFailed = false;
        try
        {
            playlists = await PlaylistManager.GetPublicPlaylistsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load public playlists");
            loadFailed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreatePlaylistAsync()
    {
        if (string.IsNullOrWhiteSpace(userId))
            return;

        busy = true;
        message = null;
        try
        {
            var playlist = await PlaylistManager.CreateAsync(userId, createModel.Name, createModel.Description);
            Navigation.NavigateTo($"/playlists/{playlist.Id}");
        }
        catch (ArgumentException exception)
        {
            message = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            message = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to create playlist");
            message = "The playlist couldn't be created. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class CreatePlaylistInput
    {
        [Required, MaxLength(100)]
        public string Name { get; set; } = string.Empty;

        [MaxLength(1000)]
        public string Description { get; set; } = string.Empty;
    }
}
