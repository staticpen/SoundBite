@page "/notifications/settings"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SoundBite.Models
@using SoundBite.Services
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<NotificationSettings> Logger

<PageTitle>Notification settings - SoundBite</PageTitle>

<h1>Notification settings</h1>

@if (loading)
{
    <p role="status">Loading notification settings...</p>
}
else if (!signedIn)
{
    <p><a href="/login">Log in</a> to manage your notification settings.</p>
}
else if (loadFailed)
{
    <div class="alert alert-danger" role="alert">
        Notification settings couldn't be loaded.
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Try again</button>
    </div>
}
else
{
    <p class="text-muted">
        Changes apply to new notifications. Existing notifications and your unread count aren't changed.
    </p>

    <fieldset>
        <legend class="h5">Notify me when...</legend>
        @foreach (var category in categories)
        {
            <div class="form-check form-switch mb-2" @key="category.Type">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="@($"notify-{category.Type}")"
                       checked="@(!disabledTypes.Contains(category.Type))"
                       disabled="@saving"
                       @onchange="args => SaveAsync(category.Type, (bool)args.Value!)" />
                <label class="form-check-label" for="@($"notify-{category.Type}")">@category.Label</label>
            </div>
        }
    </fieldset>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="alert @(messageIsError ? "alert-danger" : "alert-success") mt-3" role="status">@message</p>
    }
}

<p class="mt-3"><a href="/notifications">Back to notifications</a></p>

@code {
    private static readonly (NotificationType Type, string Label)[] categories =
    [
        (NotificationType.Follow, "Someone follows you"),
        (NotificationType.ReviewComment, "Someone comments on your review"),
        (NotificationType.CommentReply, "Someone replies to your comment"),
        (NotificationType.ReviewLike, "Someone likes your review"),
        (NotificationType.CommentLike, "Someone likes your comment")
    ];

    private readonly HashSet<NotificationType> disabledTypes = [];
    private bool loading = true;
    private bool loadFailed;
    private bool signedIn;
    private bool saving;
    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        signedIn = user.Identity?.IsAuthenticated == true &&
            !string.IsNullOrWhiteSpace(user.FindFirstValue(ClaimTypes.NameIdentifier));
        if (signedIn)
            await LoadAsync();
        else
            loading = false;
    }

    // The switches are hidden while this runs, so nothing can be edited from stale settings.
    private async Task LoadAsync()
    {
        loading = true;
        loadFailed = false;
        StateHasChanged();
        try
        {
            var disabled = await NotificationService.GetDisabledTypesAsync();
            disabledTypes.Clear();
            disabledTypes.UnionWith(disabled);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load notification settings");
            loadFailed = true;
        }
        finally
        {
            loading = false;
        }
    }

    // The checkbox is on when the category is enabled. The new state is shown straight away and
    // saved; if saving fails the previous state is restored, so the switch always matches what is saved.
    private async Task SaveAsync(NotificationType type, bool enabled)
    {
        if (saving || loading) return;
        var wasEnabled = !disabledTypes.Contains(type);
        saving = true;
        message = null;
        SetEnabled(type, enabled);
        StateHasChanged();
        try
        {
            await NotificationService.SetTypeEnabledAsync(type, enabled);
            message = "Preferences saved.";
            messageIsError = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save notification setting {NotificationType}", type);
            SetEnabled(type, wasEnabled);
            message = "Your preference couldn't be saved. Please try again.";
            messageIsError = true;
        }
        finally
        {
            saving = false;
        }
        StateHasChanged();
    }

    private void SetEnabled(NotificationType type, bool enabled)
    {
        if (enabled)
            disabledTypes.Remove(type);
        else
            disabledTypes.Add(type);
    }
}
