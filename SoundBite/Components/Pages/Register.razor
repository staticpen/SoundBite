@page "/register"
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using SoundBite.Data
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Create Account | SoundBite</PageTitle>

<div class="register-container">
    <div class="register-card">
        <h1>Join SoundBite</h1>
        <p class="subtitle">Discover music. Share your taste.</p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="message @(isSuccess ? "success" : "error")" role="alert">
                @message
            </div>
        }

        <EditForm method="post" FormName="register" Model="model" OnValidSubmit="RegisterAsync" OnInvalidSubmit="ClearPasswords">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username"
                           class="form-control"
                           @bind-Value="model.UserName"
                           autocomplete="username" />
                <ValidationMessage For="@(() => model.UserName)" />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email"
                           class="form-control"
                           @bind-Value="model.Email"
                           autocomplete="email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password"
                           type="password"
                           class="form-control"
                           @bind-Value="model.Password"
                           autocomplete="new-password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm password</label>
                <InputText id="confirmPassword"
                           type="password"
                           class="form-control"
                           @bind-Value="model.ConfirmPassword"
                           autocomplete="new-password" />
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            <button type="submit" class="register-button" disabled="@isSubmitting">
                @(isSubmitting ? "Creating account..." : "Create account")
            </button>
        </EditForm>

        <p class="login-prompt">
            Already have an account? <a href="/login">Log in</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "register")]
    private RegisterModel model { get; set; } = default!;

    // Make sure the registration form has a model before it is rendered.
    protected override void OnInitialized() => model ??= new();
    private string? message;
    private bool isSuccess;
    private bool isSubmitting;

    // Validate the confirmation, create the account, and sign in the new user.
    private async Task RegisterAsync()
    {
        if (model.Password != model.ConfirmPassword)
        {
            message = "Your passwords do not match.";
            isSuccess = false;
            ClearPasswords();
            return;
        }

        isSubmitting = true;
        message = null;

        try
        {
            var user = new ApplicationUser { UserName = model.UserName.Trim(), Email = model.Email.Trim() };
            var result = await UserManager.CreateAsync(user, model.Password);
            if (!result.Succeeded)
            {
                message = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            await SignInManager.SignInAsync(user, isPersistent: false);
            Navigation.NavigateTo("/account", forceLoad: true);
        }
        finally
        {
            ClearPasswords();
            isSubmitting = false;
        }
    }

    // Clear password fields after registration succeeds or fails.
    private void ClearPasswords()
    {
        model.Password = string.Empty;
        model.ConfirmPassword = string.Empty;
    }

    public sealed class RegisterModel
    {
        [Required(ErrorMessage = "Please enter a username.")]
        [StringLength(30, MinimumLength = 3,
            ErrorMessage = "Username must be between 3 and 30 characters.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter a password.")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

}
