@page "/account"
@page "/login"
@page "/register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SoundBite.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Account</PageTitle>

<h1>Account</h1>

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h4">Signed in</h2>
                <p class="mb-1"><strong>Username:</strong> @authContext.User.Identity?.Name</p>
                <p class="mb-1"><strong>Email:</strong> @userEmail</p>
                <p class="mb-3"><strong>Public profile:</strong> <a href="@profileUrl">@profileName</a></p>
                <button class="btn btn-outline-secondary" @onclick="LogoutAsync">Log out</button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h4">Edit profile</h2>
                <EditForm Model="profileModel" OnValidSubmit="SaveProfileAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Display name</label>
                        <InputText @bind-Value="profileModel.DisplayName" class="form-control" maxlength="80" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bio</label>
                        <InputTextArea @bind-Value="profileModel.Bio" class="form-control" maxlength="500" rows="4" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isBusy">Save profile</button>
                    @if (!string.IsNullOrWhiteSpace(profileMessage))
                    {
                        <div class="alert @(profileSaved ? "alert-success" : "alert-danger") mt-3 mb-0" role="status">@profileMessage</div>
                    }
                </EditForm>
            </div>
        </div>
    </Authorized>
    <NotAuthorized Context="anonContext">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h4">Create account</h2>
                        <EditForm Model="registerModel" OnValidSubmit="RegisterAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <InputText @bind-Value="registerModel.UserName" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <InputText @bind-Value="registerModel.Email" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <InputText type="password" @bind-Value="registerModel.Password" class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@isBusy">Create account</button>
                            @if (!string.IsNullOrWhiteSpace(registerMessage))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@registerMessage</div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h4">Log in</h2>
                        <EditForm Model="loginModel" OnValidSubmit="LoginAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Username or email</label>
                                <InputText @bind-Value="loginModel.UserNameOrEmail" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <InputText type="password" @bind-Value="loginModel.Password" class="form-control" />
                            </div>

                            <button type="submit" class="btn btn-success" disabled="@isBusy">Log in</button>
                            @if (!string.IsNullOrWhiteSpace(loginMessage))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@loginMessage</div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly RegisterInput registerModel = new();
    private readonly LoginInput loginModel = new();
    private bool isBusy;
    private string? registerMessage;
    private string? loginMessage;
    private string? profileMessage;
    private string userEmail = string.Empty;
    private string profileName = string.Empty;
    private string profileUrl = "/account";
    private bool profileSaved;
    private readonly ProfileInput profileModel = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        userEmail = user?.Email ?? string.Empty;
        if (user is not null)
        {
            profileModel.DisplayName = user.DisplayName;
            profileModel.Bio = user.Bio ?? string.Empty;
            profileName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.UserName ?? string.Empty : user.DisplayName;
            profileUrl = $"/users/{Uri.EscapeDataString(user.UserName ?? string.Empty)}";
        }
    }

    private async Task RegisterAsync()
    {
        registerMessage = null;
        isBusy = true;
        try
        {
            var user = new ApplicationUser
            {
                UserName = registerModel.UserName.Trim(),
                Email = registerModel.Email.Trim()
            };

            var result = await UserManager.CreateAsync(user, registerModel.Password);
            if (!result.Succeeded)
            {
                registerMessage = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            await SignInManager.SignInAsync(user, isPersistent: false);
            registerModel.Reset();
            Navigation.NavigateTo("/account", forceLoad: false);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoginAsync()
    {
        loginMessage = null;
        isBusy = true;
        try
        {
            var user = await UserManager.FindByNameAsync(loginModel.UserNameOrEmail)
                ?? await UserManager.FindByEmailAsync(loginModel.UserNameOrEmail);

            if (user is null)
            {
                loginMessage = "Invalid username or password.";
                return;
            }

            var result = await SignInManager.PasswordSignInAsync(
                user,
                loginModel.Password,
                isPersistent: false,
                lockoutOnFailure: false);

            if (!result.Succeeded)
            {
                loginMessage = "Invalid username or password.";
                return;
            }

            loginModel.Reset();
            Navigation.NavigateTo("/account", forceLoad: false);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await SignInManager.SignOutAsync();
        Navigation.NavigateTo("/account", forceLoad: false);
    }

    private async Task SaveProfileAsync()
    {
        profileMessage = null;
        profileSaved = false;
        isBusy = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(state.User);
            if (user is null)
            {
                profileMessage = "Your session has expired. Please sign in again.";
                return;
            }

            user.DisplayName = profileModel.DisplayName.Trim();
            user.Bio = string.IsNullOrWhiteSpace(profileModel.Bio) ? null : profileModel.Bio.Trim();
            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded)
            {
                profileMessage = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            profileName = string.IsNullOrWhiteSpace(user.DisplayName) ? user.UserName ?? string.Empty : user.DisplayName;
            profileUrl = $"/users/{Uri.EscapeDataString(user.UserName ?? string.Empty)}";
            profileMessage = "Profile saved.";
            profileSaved = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class RegisterInput
    {
        [Required]
        public string UserName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(8)]
        public string Password { get; set; } = string.Empty;

        public void Reset()
        {
            UserName = string.Empty;
            Email = string.Empty;
            Password = string.Empty;
        }
    }

    private sealed class LoginInput
    {
        [Required]
        public string UserNameOrEmail { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public void Reset()
        {
            UserNameOrEmail = string.Empty;
            Password = string.Empty;
        }
    }

    private sealed class ProfileInput
    {
        [Required, MaxLength(80)]
        public string DisplayName { get; set; } = string.Empty;

        [MaxLength(500)]
        public string Bio { get; set; } = string.Empty;
    }
}
