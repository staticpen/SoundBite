@page "/artists/{Id:int}"
@attribute [StreamRendering]
@using SoundBite.Interfaces
@using SoundBite.Models
@inject IMusicCatalog Catalog
@inject ILogger<ArtistDetails> Logger

<PageTitle>@(artist?.Name ?? "Artist details") - SoundBite</PageTitle>

@if (loading)
{
    <p role="status">Loading artist...</p>
}
else if (Id <= 0)
{
    <div class="alert alert-warning" role="alert">Invalid artist ID. Please use a positive whole number.</div>
}
else if (loadFailed)
{
    <div class="alert alert-danger" role="alert">The artist couldn't be loaded. Please try again later.</div>
}
else if (artist is null)
{
    <div class="alert alert-info" role="status">Artist not found.</div>
}
else
{
    <article>
        <p><a href="/search">Search</a></p>
        <h1>@artist.Name</h1>
        @if (!string.IsNullOrWhiteSpace(artist.SpotifyId))
        {
            <a class="btn btn-outline-success mb-3" href="@SpotifyUrl(artist.SpotifyId)">Open artist on Spotify</a>
        }

        <section class="mt-3" aria-labelledby="artist-albums">
            <h2 id="artist-albums">Albums (@artist.Albums.Count)</h2>
            @if (artist.Albums.Count == 0)
            {
                <p class="text-muted">No albums are linked to this artist yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var album in artist.Albums.OrderBy(album => album.Title).ThenBy(album => album.Id))
                    {
                        <li class="list-group-item" @key="album.Id">
                            <a href="@($"/albums/{album.Id}")" class="sb-item-title">@album.Title</a>
                            <span class="text-muted"> · @album.Tracks.Count tracks</span>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="mt-4" aria-labelledby="artist-tracks">
            <h2 id="artist-tracks">Credited tracks (@artist.Tracks.Count)</h2>
            @if (artist.Tracks.Count == 0)
            {
                <p class="text-muted">No tracks are credited directly to this artist yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var track in artist.Tracks.OrderBy(track => track.Title).ThenBy(track => track.Id))
                    {
                        <li class="list-group-item" @key="track.Id">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(track.Album?.CoverUrl))
                                {
                                    <img class="catalogue-cover catalogue-cover-thumb" src="@track.Album.CoverUrl"
                                         alt="@($"{track.Title} album cover")" loading="lazy" />
                                }
                                <div class="min-w-0">
                                    <a href="@($"/tracks/{track.Id}")" class="sb-item-title">@track.Title</a>
                                    @if (track.Album is not null)
                                    {
                                        <div class="text-muted small"><a href="@($"/albums/{track.Album.Id}")">@track.Album.Title</a></div>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </article>
}

@code {
    [Parameter] public int Id { get; set; }

    private Artist? artist;
    private bool loading;
    private bool loadFailed;

    protected override async Task OnParametersSetAsync()
    {
        artist = null;
        loadFailed = false;
        loading = Id > 0;
        if (!loading) return;

        try
        {
            artist = await Catalog.GetArtistAsync(Id);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load artist {ArtistId}", Id);
            loadFailed = true;
        }
        finally
        {
            loading = false;
        }
    }

    private static string SpotifyUrl(string id) =>
        $"https://open.spotify.com/artist/{Uri.EscapeDataString(id)}";
}
