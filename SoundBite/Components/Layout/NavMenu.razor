@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@implements IDisposable
@using SoundBite.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService NotificationService
@inject NotificationEventDispatcher NotificationEventDispatcher
@inject NotificationCircuitHandler NotificationCircuitHandler
@inject NavigationManager Navigation
@inject ILogger<NavMenu> Logger

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SoundBite</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="search">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Search
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="feed">
                <span class="bi bi-activity" aria-hidden="true"></span> Activity Feed
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="rankings">
                <span class="bi bi-bar-chart-fill" aria-hidden="true"></span> Ratings and Trends
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="playlists">
                <span class="bi bi-music-note-list" aria-hidden="true"></span> Playlists
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @if (!signedIn)
            {
                <NavLink class="nav-link" href="register">Create account</NavLink>
                <NavLink class="nav-link" href="login">Log in</NavLink>
            }
            else
            {
                <details class="account-menu">
                <summary class="nav-link" @onclick:stopPropagation="true">
                    <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span> Account
                </summary>
                <div class="account-menu-links">
                    <NavLink class="nav-link" href="account">Edit Profile</NavLink>
                    <NavLink class="nav-link" href="notifications">
                        Notifications
                        @if (signedIn && notificationCount is int unread && unread > 0)
                        {
                            <span class="badge text-bg-primary ms-1" aria-label="@($"{unread} unread notifications")">@unread</span>
                        }
                        else if (signedIn && notificationCountFailed)
                        {
                            <span class="badge text-bg-warning ms-1" title="Unread notification count unavailable">!</span>
                        }
                    </NavLink>
                    <AuthorizeView Roles="Administrator">
                        <Authorized>
                            <NavLink class="nav-link" href="admin/users">Admin</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </details>
            }
        </div>
    </nav>
</div>

@code {
    private bool signedIn;
    private int? notificationCount;
    private bool notificationCountFailed;
    private readonly List<IDisposable> subscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        signedIn = user.Identity?.IsAuthenticated == true &&
            !string.IsNullOrWhiteSpace(user.FindFirstValue(ClaimTypes.NameIdentifier));
        if (!signedIn)
            return;

        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;
        subscriptions.Add(NotificationEventDispatcher.Subscribe(
            userId,
            () => InvokeAsync(RefreshUnreadCountAsync)));
        subscriptions.Add(NotificationCircuitHandler.Subscribe(
            () => InvokeAsync(RefreshUnreadCountAsync)));
        Navigation.LocationChanged += HandleLocationChanged;
        try
        {
            notificationCount = await NotificationService.GetUnreadCountAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load unread notification count");
            notificationCountFailed = true;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(RefreshUnreadCountAsync);

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            notificationCount = await NotificationService.GetUnreadCountAsync();
            notificationCountFailed = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to refresh unread notification count");
            notificationCountFailed = true;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        foreach (var subscription in subscriptions)
            subscription.Dispose();
    }
}
